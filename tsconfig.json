{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@fixtures/*": [
        "src/fixtures/*"
      ],
      "@helpers/*": [
        "src/helpers/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@data/*": [
        "src/data/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@flows/*": [
        "src/flows/*"
      ],
      "@task/*": [
        "src/task/*"
      ],
      "@question/*": [
        "src/question/*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "config/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
