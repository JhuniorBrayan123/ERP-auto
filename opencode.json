{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bookstack": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp-bookstack/dist/index.js"
      ],
      "enabled": true,
      "timeout": 10000
    },

    "excalidraw": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-excalidraw-server"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },

  "permission": {
    "*": "ask",

    "read": "allow",
    "grep": "allow",
    "glob": "allow",

    "edit": "ask",
    "bash": "ask",

    "bookstack_*": "ask",
    "excalidraw_*": "ask"
  }
}