{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bookstack": {
      "type": "local",
      "command": [
        "node",
        "E:\\2026-I\\MCP-Boockstack\\dist\\index.js"
      ],
      "enabled": true,
      "timeout": 10000,
      "environment": {
        "BOOKSTACK_BASE_URL": "{env:BOOKSTACK_BASE_URL}",
        "BOOKSTACK_TOKEN_ID": "{env:BOOKSTACK_TOKEN_ID}",
        "BOOKSTACK_TOKEN_SECRET": "{env:BOOKSTACK_TOKEN_SECRET}"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "ask",
    "bash": "ask",
    "bookstack_*": "ask"
  }
}