# ─────────────────────────────────────────────────────────────
# Variables de entorno para OpenCode (MCP BookStack)
# ─────────────────────────────────────────────────────────────
# REQUISITO: Copia este archivo como '.env' en la raíz del proyecto
# y completa con TUS valores de BookStack (o tus variables de entorno).
#
# El agente consulta BookStack como fuente de la verdad (Book 9 /
# Chapter 6 "Guias QA"). Sin estas variables el MCP BookStack no
# puede conectarse y el agente no puede consultar la documentación.

# URL base del servidor BookStack
BOOKSTACK_BASE_URL=http://TU_SERVIDOR_BOOKSTACK

# Token ID de la API de BookStack (Admin > API Tokens)
BOOKSTACK_TOKEN_ID=TU_TOKEN_ID

# Token Secret de la API de BookStack (se muestra una sola vez)
BOOKSTACK_TOKEN_SECRET=TU_TOKEN_SECRET
