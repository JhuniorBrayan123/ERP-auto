# ─────────────────────────────────────────────────────────────
# Variables de entorno para los MCPs del proyecto (BookStack y GitLab)
# ─────────────────────────────────────────────────────────────
# REQUISITO: Copia este archivo como '.env' en la raíz del proyecto
# y completa con TUS valores. Este '.env' de la raíz es la ÚNICA fuente
# de credenciales de los servidores MCP en tools/ (los '.env.example' de
# cada MCP son solo documentación y no se usan en runtime).
#
# BookStack: el agente consulta BookStack como fuente de la verdad
# (Book 9 / Chapter 6 "Guias QA"). Sin estas variables el MCP BookStack
# no puede conectarse.
# GitLab: sin GITLAB_URL/GITLAB_TOKEN el MCP GitLab no puede operar sobre
# el repositorio (MRs, diffs, pipelines).

# ── MCP BookStack ─────────────────────────────────────────────
# URL base del servidor BookStack
BOOKSTACK_BASE_URL=http://TU_SERVIDOR_BOOKSTACK

# Token ID de la API de BookStack (Admin > API Tokens)
BOOKSTACK_TOKEN_ID=TU_TOKEN_ID

# Token Secret de la API de BookStack (se muestra una sola vez)
BOOKSTACK_TOKEN_SECRET=TU_TOKEN_SECRET

# ── MCP GitLab ────────────────────────────────────────────────
# URL base del servidor GitLab
GITLAB_URL=https://gitlab.sreasons.com

# Token personal de GitLab (Settings > Access Tokens). Para operaciones de
# escritura (crear/aprobar MRs) requiere scope `api`; para solo lectura `read_api`.
GITLAB_TOKEN=tu_token_personal
