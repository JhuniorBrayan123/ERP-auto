APP_ENV=prd

# Credenciales de prueba
USER_EMAIL=tu_correo_de_prueba@gmail.com
USER_PASSWORD=TuPassword123.

## ── Discord — reporter de resumen E2E (opcional) ─────────────────
## Copia este archivo como 'environment.env' y completa con TUS valores locales.
## Gate: DISCORD_REPORT_ENABLED=1 activa el reporter (por defecto apagado).
DISCORD_REPORT_ENABLED=0

# URL del Webhook del canal de Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/TU_WEBHOOK_ID/TU_WEBHOOK_TOKEN

# Nombre que aparecerá en el reporte (ej. Juan Perez)
DISCORD_TESTER_NAME=TuNombre

# Tu ID numérico de Discord (para que el reporte te mencione)
DISCORD_USER_ID=123456789
