# Credenciales para el MCP BookStack.
# NO edites este archivo: copialo como `.env` y completa con TUS valores.
# En el flujo normal, OpenCode inyecta estas variables desde el `.env`
# de la raíz del proyecto (opencode.json usa {env:BOOKSTACK_*}).
BOOKSTACK_BASE_URL=https://tu-bookstack.com
BOOKSTACK_TOKEN_ID=tu_token_id
BOOKSTACK_TOKEN_SECRET=tu_token_secret
